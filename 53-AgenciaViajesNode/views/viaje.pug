extends ./layout/index

block contenido 
    main.container.mt-5
        .row
            .col-md-5
                img(src=`/img/destinos_${viaje.imagen}_ln.jpg`, alt=`Imagen viaje ${viaje.titulo}`, class="img-fluid")
            .col-md-7
                h1 #{viaje.titulo}
                p
                    svg(xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewbox='0 0 24 24' fill='none' stroke='#dc135f' stroke-width='1' stroke-linecap='round' stroke-linejoin='round')
                        path(d='M4 5m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z')
                        path(d='M16 3l0 4')
                        path(d='M8 3l0 4')
                        path(d='M4 11l16 0')
                        path(d='M8 15h2v2h-2z')
                    | #{viaje.fecha_ida} - #{viaje.fecha_vuelta}

                p
                    svg(xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewbox='0 0 24 24' fill='none' stroke='#dc135f' stroke-width='1' stroke-linecap='round' stroke-linejoin='round')
                        path(d='M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0')
                        path(d='M21 21l-6 -6')
                        path(d='M12 7h-2.5a1.5 1.5 0 0 0 0 3h1a1.5 1.5 0 0 1 0 3h-2.5')
                        path(d='M10 13v1m0 -8v1')
                    | #{viaje.precio} €


                p
                    svg(xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewbox='0 0 24 24' fill='none' stroke='#dc135f' stroke-width='1' stroke-linecap='round' stroke-linejoin='round')
                        path(d='M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0')
                        path(d='M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2')
                        path(d='M16 3.13a4 4 0 0 1 0 7.75')
                        path(d='M21 21v-2a4 4 0 0 0 -3 -3.85')

                    | #{viaje.disponibles} Disponibles
                p= viaje.descripcion
                
